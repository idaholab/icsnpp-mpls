[package]
script_dir = zkg-loader
build_command = ./configure && cmake --build build
test_command = cd testing && btest -c btest.cfg
summary = Zeek plugin for parsing and logging MPLS label stacks
description = Parses MPLS unicast label stacks carried over Ethernet or VLANs,
	records the decoded labels, traffic class values, and TTL values in
	mpls_header.log, and hands the payload to Zeek's IP or Ethernet analyzer,
	including Ethernet pseudowires with or without a control word.
tags = mpls, MPLS, ics, ICS, CISA, INL, ICSNPP, icsnpp, zeek plugin, packet analyzer

[template]
source = https://github.com/zeek/package-template
version = v3.1.8
zkg_version = 2.14.0
features = plugin

[template_vars]
name = MPLS
namespace = ICSNPP
