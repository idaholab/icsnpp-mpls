[package]
script_dir = scripts
build_command = ./configure && cmake --build build
test_command = cd testing && btest -c btest.cfg
summary = Zeek plugin for parsing and logging MPLS label stacks
description = Parses MPLS unicast label stacks carried over Ethernet or VLANs
	and records the decoded labels, traffic class values, bottom-of-stack flags,
	and TTL values in mpls_header.log.

[template]
source = https://github.com/zeek/package-template
version = v3.1.8
zkg_version = 2.14.0
features = plugin

[template_vars]
name = MPLS
namespace = MPLSLogging
